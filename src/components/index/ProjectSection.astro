---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { getGithubRepos } from "../../lib/github";

// Fetch local projects from .md files
const localProjects = await getCollection("projects");

const githubUsername = "na-ive";
const githubRepos = await getGithubRepos(githubUsername);

// Improved merge logic:
// 1. Map local projects and find their GitHub data
// 2. Add GitHub repos that aren't represented in local projects
// 3. Deduplicate by repository name

const projectsSet = new Map();
const seenRepoNames = new Set();

// Process local projects first (Manual overrides)
localProjects.forEach((lp) => {
  const repoNameFromUrl = lp.data.githubUrl
    ?.split("/")
    .filter(Boolean)
    .pop()
    ?.toLowerCase();
  const githubRepo = githubRepos.find(
    (r) => r.name.toLowerCase() === repoNameFromUrl,
  );

  const socialImage = `https://opengraph.githubassets.com/1/${githubUsername}/${githubRepo?.name}`;

  projectsSet.set(lp.id, {
    title: lp.data.title || githubRepo?.name || "Untitled",
    description: lp.data.description || githubRepo?.description || "",
    image: lp.data.image || (githubRepo ? socialImage : null),
    tags: lp.data.tags || githubRepo?.topics || [],
    url: lp.data.githubUrl || githubRepo?.html_url || "#",
    stars: githubRepo?.stargazers_count || 0,
    order: lp.data.order,
    isLocal: true,
  });

  if (repoNameFromUrl) {
    seenRepoNames.add(repoNameFromUrl);
  }
});

// Add remaining GitHub repos that aren't in localProjects
githubRepos.forEach((repo) => {
  if (seenRepoNames.has(repo.name.toLowerCase())) return;

  // Exclude specific repos: Profile README and the Portfolio site itself
  const excludedRepos = [
    githubUsername.toLowerCase(),
    `${githubUsername.toLowerCase()}.github.io`,
  ];
  if (excludedRepos.includes(repo.name.toLowerCase())) return;

  // Optional: Filter out trivial repos if desired, but here we include them for "auto update"
  projectsSet.set(`gh-${repo.name}`, {
    title: repo.name,
    description: repo.description,
    image: `https://opengraph.githubassets.com/1/${githubUsername}/${repo.name}`,
    tags: repo.topics || [],
    url: repo.html_url,
    stars: repo.stargazers_count,
    order: 999,
    isLocal: false,
  });
});

const featuredProjects = Array.from(projectsSet.values())
  .sort((a, b) => {
    // Priority: Order from .md first, then Stars
    if (a.order !== b.order) return a.order - b.order;
    return b.stars - a.stars;
  })
  .slice(0, 6);
---

<section id="projects" class="pt-20">
  <h2
    class="mx-4 text-4xl lg:text-5xl font-semibold text-[var(--md-sys-color-on-surface)] mb-8"
  >
    Projects
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {
      featuredProjects.map((project) => (
        <a
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col bg-[var(--md-sys-color-surface-container)] hover:bg-[var(--md-sys-color-secondary-container)] rounded-[28px] overflow-hidden transition-all duration-300"
        >
          <div class="relative overflow-hidden h-48 flex items-center justify-center bg-[var(--md-sys-color-surface-container-high)] text-white text-6xl rounded-[28px]">
            {project.image ? (
              typeof project.image === "string" ? (
                <img
                  src={project.image}
                  alt={project.title}
                  class="absolute inset-0 h-full w-full object-cover z-0"
                  loading="lazy"
                />
              ) : (
                <Image
                  src={project.image}
                  alt={project.title}
                  class="absolute inset-0 h-full w-full object-cover z-0"
                  width="500"
                  height="500"
                />
              )
            ) : (
              <div class="flex items-center justify-center w-full h-full text-[var(--md-sys-color-primary)] opacity-20">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="w-20 h-20"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"
                  />
                </svg>
              </div>
            )}
          </div>
          <div class="p-6 flex flex-col flex-grow">
            <div class="flex justify-between items-start mb-2">
              <h3 class="text-2xl font-bold text-[var(--md-sys-color-on-surface)] leading-tight">
                {project.title}
              </h3>
              {project.stars > 0 && (
                <span class="flex items-center gap-1 text-sm text-[var(--md-sys-color-on-surface-variant)]">
                  ★ {project.stars}
                </span>
              )}
            </div>
            <p class="text-[var(--md-sys-color-on-surface-variant)] mb-4 line-clamp-3 text-sm flex-grow">
              {project.description}
            </p>
            <div class="flex gap-2 flex-wrap mt-auto">
              {project.tags.slice(0, 3).map((tag: string, index: number) => (
                <span
                  class={`px-3 py-1 bg-[var(--md-sys-color-tertiary-container)] text-[var(--md-sys-color-on-tertiary-container)] text-sm font-medium
                ${
                  index === 0
                    ? "rounded-r-xl rounded-l-4xl"
                    : index === 2
                    ? "rounded-r-4xl rounded-l-xl"
                    : "rounded-md"
                }`}
                >
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))
    }
  </div>
</section>
