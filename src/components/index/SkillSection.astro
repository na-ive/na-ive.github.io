---
const skills = ['JavaScript', 'Python', 'PHP', 'React', 'Node.js', 'Next.js', 'Laravel', 'Tailwind', 'Git', 'VS Code', 'PostgreSQL', 'MySQL'];

// Fungsi untuk mendapatkan class rounded dinamis
const getRoundedClass = (index: number, total: number, colsPerRow: number) => {
  const isFirstInRow = index % colsPerRow === 0;
  const isLastInRow = (index + 1) % colsPerRow === 0 || index === total - 1;

  if (isFirstInRow && isLastInRow) {
    return 'rounded-4xl';
  } else if (isFirstInRow) {
    return 'rounded-l-4xl rounded-r-xl';
  } else if (isLastInRow) {
    return 'rounded-r-4xl rounded-l-xl';
  } else {
    return 'rounded-xl';
  }
};
---

<section id="skills" class="pt-20">
  <h2 class="mx-4 text-4xl lg:text-5xl font-semibold text-[var(--md-sys-color-on-surface)] mb-8">
    Skills & Technologies
  </h2>

  <div class="grid grid-cols-2 gap-2 md:hidden">
    {skills.map((skill, i) => (
      <div
        class={`bg-[var(--md-sys-color-secondary-container)] text-[var(--md-sys-color-on-secondary-container)] hover:bg-[var(--md-sys-color-primary-container)] hover:text-[var(--md-sys-color-on-primary-container)] p-6 text-center transition-colors duration-300 hover:rounded-4xl ${getRoundedClass(i, skills.length, 2)}`}
      >
        <p class="font-semibold text-lg cursor-default">{skill}</p>
      </div>
    ))}
  </div>

  <div class="hidden md:grid lg:hidden grid-cols-3 gap-2">
    {skills.map((skill, i) => (
      <div
        class={`bg-[var(--md-sys-color-secondary-container)] text-[var(--md-sys-color-on-secondary-container)] hover:bg-[var(--md-sys-color-primary-container)] hover:text-[var(--md-sys-color-on-primary-container)] p-6 text-center transition-colors duration-300 hover:rounded-4xl ${getRoundedClass(i, skills.length, 3)}`}
      >
        <p class="font-semibold text-lg cursor-default">{skill}</p>
      </div>
    ))}
  </div>

  <div class="hidden lg:grid grid-cols-4 gap-2">
    {skills.map((skill, i) => (
      <div
        class={`bg-[var(--md-sys-color-secondary-container)] text-[var(--md-sys-color-on-secondary-container)] hover:bg-[var(--md-sys-color-primary-container)] hover:text-[var(--md-sys-color-on-primary-container)] p-6 text-center transition-colors duration-300 hover:rounded-4xl ${getRoundedClass(i, skills.length, 4)}`}
      >
        <p class="font-semibold text-lg cursor-default">{skill}</p>
      </div>
    ))}
  </div>
</section>
